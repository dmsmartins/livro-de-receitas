&#x20;   ["Manteiga", 15, "g"],\
&#x20;   ["Farinha de trigo", 15, "g"],\
&#x20;   ["Leite meio-gordo", 250, "ml"],\
&#x20;   ["Queijo Gruyère ralado", 40, "g"],\
